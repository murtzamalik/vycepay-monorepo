# Copy to logging/.env and set secrets. Never commit logging/.env.
ELASTIC_PASSWORD=change-me-strong-password
KIBANA_SYSTEM_PASSWORD=change-me-strong-password

# Cap ES heap — keep low if sharing the app host (prefer a second VM in prod)
ES_HEAP=512m

# Data stream / Filebeat env label
VYCEPAY_LOG_ENV=prod

# Bind to localhost only (safe default). Change only behind VPN/firewall.
PUBLISH_ES_PORT=127.0.0.1:9200
PUBLISH_KIBANA_PORT=127.0.0.1:5601

# Optional public URL for Kibana
KIBANA_PUBLIC_BASE_URL=http://127.0.0.1:5601
